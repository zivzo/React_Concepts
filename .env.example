# Google AdSense — copy this file to `.env.local` and fill in your values.
# Leave VITE_ADSENSE_CLIENT empty to build the app without ads.
#
# Publisher ID, e.g. ca-pub-1234567890123456
VITE_ADSENSE_CLIENT=
# Ad unit IDs for the 160×600 left and right banners, e.g. 1234567890
VITE_ADSENSE_SLOT_LEFT=
VITE_ADSENSE_SLOT_RIGHT=
